    "You closed the app with %lld cards not yet in your collection. Don't worry — we Kept them for you." : {
      "comment" : "A message in the alert that appears when the user closes the app while the app is running. The number in parentheses is the number of cards that were not added to their collection.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Hai chiuso l’app con %lld carta non ancora nella tua collezione. Non preoccuparti, l’abbiamo Kept per te."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Hai chiuso l’app con %lld carte non ancora nella tua collezione. Non preoccuparti, le abbiamo Kept per te."
                }
              }
            }
          }
        }
      }
    },
    "You just " : {
      "localizations" : {
        "it" : {
